# Copy to repository-root .env.deploy (ignored by Git). Never use the local .env.
# API_DOMAIN is a hostname only: an owned domain or a stable free subdomain.
API_DOMAIN=api.example.com
# Exact HTTPS Origin; do not allow all *.vercel.app or include a trailing slash.
# Leave this reserved placeholder until the frontend teammate supplies the URL.
FRONTEND_ORIGIN=https://frontend.example.com

IMAGE_PREFIX=ghcr.io/404-worker-not-found/be
# Use one full Git commit SHA for all eight images, never latest.
IMAGE_TAG=replace-with-full-commit-sha

# Generate each value separately, e.g. openssl rand -hex 32.
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
AUTH_DB_PASSWORD=replace-with-random-auth-password
MEMBER_DB_PASSWORD=replace-with-random-member-password
JOB_DB_PASSWORD=replace-with-random-job-password
MATCHING_DB_PASSWORD=replace-with-random-matching-password
WORK_DB_PASSWORD=replace-with-random-work-password
CHAT_DB_PASSWORD=replace-with-random-chat-password
PAYMENT_DB_PASSWORD=replace-with-random-payment-password
NOTIFICATION_DB_PASSWORD=replace-with-random-notification-password
AUTH_JWT_SECRET=replace-with-random-jwt-secret
INTERNAL_API_SECRET=replace-with-random-internal-secret

# Optional provider credentials. Empty values do not enable a fake successful flow.
AUTH_MAIL_USERNAME=
AUTH_MAIL_PASSWORD=
AUTH_SOLAPI_API_KEY=
AUTH_SOLAPI_API_SECRET=
AUTH_VERIFICATION_SMS_FROM=
NTS_BUSINESS_API_SERVICE_KEY=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
TOSS_ENABLED=false
TOSS_SECRET_KEY=
