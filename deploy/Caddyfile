# Serves only one service's Swagger UI and spec under /docs/{name}.
(swagger) {
    # Without a prefix, springdoc keeps the public API root as the server URL.
    @swaggerSpec{args[0]} path /docs/{args[0]}/v3/api-docs
    handle @swaggerSpec{args[0]} {
        uri strip_prefix /docs/{args[0]}
        reverse_proxy 127.0.0.1:{args[1]}
    }
    @swaggerUi{args[0]} path /docs/{args[0]}/v3/api-docs/swagger-config /docs/{args[0]}/swagger-ui.html /docs/{args[0]}/swagger-ui/*
    handle @swaggerUi{args[0]} {
        uri strip_prefix /docs/{args[0]}
        reverse_proxy 127.0.0.1:{args[1]} {
            header_up X-Forwarded-Prefix /docs/{args[0]}
        }
    }
}

{$API_DOMAIN} {
    encode zstd gzip

    route {
        # The browser must never supply credentials for service-to-service APIs.
        request_header -X-Internal-Secret
        # Only the Swagger UI routes below may set a prefix; a client value would change the spec's server URL.
        request_header -X-Forwarded-Prefix

        @internal path_regexp internal ^/api/[^/]+/internal(/|$)
        respond @internal 404

        @cors header Origin {$FRONTEND_ORIGIN}
        header @cors {
            Access-Control-Allow-Origin "{$FRONTEND_ORIGIN}"
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers "Authorization, Content-Type, Idempotency-Key"
            Access-Control-Max-Age "600"
        }
        header +Vary Origin

        @preflight {
            method OPTIONS
            header Origin {$FRONTEND_ORIGIN}
        }
        respond @preflight 204
        @otherPreflight method OPTIONS
        respond @otherPreflight 403

        # These owner-facing paths belong to matching, not job-service.
        @applicants path_regexp applicants ^/api/jobs/[^/]+/applications(/|$)
        reverse_proxy @applicants 127.0.0.1:8084

        @auth path /api/auth /api/auth/*
        reverse_proxy @auth 127.0.0.1:8081
        @member path /api/members /api/members/*
        reverse_proxy @member 127.0.0.1:8082
        @job path /api/jobs /api/jobs/*
        reverse_proxy @job 127.0.0.1:8083
        @matching path /api/applications /api/applications/* /api/matchings /api/matchings/*
        reverse_proxy @matching 127.0.0.1:8084
        @work path /api/works /api/works/*
        reverse_proxy @work 127.0.0.1:8086
        @chat path /api/chat-rooms /api/chat-rooms/*
        reverse_proxy @chat 127.0.0.1:8087
        @payment path /api/payments /api/payments/*
        reverse_proxy @payment 127.0.0.1:8085
        @notification path /api/notifications /api/notifications/*
        reverse_proxy @notification 127.0.0.1:8088

        # Swagger is for the team only; its requests still call the /api routes above.
        @docs path /docs /docs/*
        basic_auth @docs {
            {$SWAGGER_USERNAME} {$SWAGGER_PASSWORD_HASH}
        }
        # Deferred so the upstream cannot add a second, conflicting value.
        header @docs {
            X-Frame-Options "DENY"
            Content-Security-Policy "frame-ancestors 'none'"
            defer
        }
        # Path matchers see the cleaned path, so reject `..` segments in the original request path.
        @docsTraversal {
            path /docs/*
            vars_regexp {http.request.orig_uri.path} (^|/)\.\.(/|$)
        }
        respond @docsTraversal 404
        import swagger auth 8081
        import swagger member 8082
        import swagger job 8083
        import swagger matching 8084
        import swagger payment 8085
        import swagger work 8086
        import swagger chat 8087
        import swagger notification 8088

        # Actuator, root Swagger paths and all unlisted routes stay off the public endpoint.
        respond 404
    }
}
