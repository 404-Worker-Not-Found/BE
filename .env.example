# Local runtime ports
AUTH_SERVICE_PORT=8081
MEMBER_SERVICE_PORT=8082
JOB_SERVICE_PORT=8083
MATCHING_SERVICE_PORT=8084

# Shared internal API secret. Use the same value for auth-service and member-service.
INTERNAL_API_SECRET=replace-with-long-random-local-internal-secret

# JWT secret. Use a long random value, preferably 32+ characters.
AUTH_JWT_SECRET=replace-with-long-random-local-jwt-secret

# auth-service datasource
AUTH_DB_NAME=auth_service
AUTH_DB_ROOT_PASSWORD=replace-with-local-auth-root-password
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=replace-with-local-auth-password
AUTH_DATASOURCE_URL=jdbc:mysql://localhost:3307/auth_service?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
AUTH_DATASOURCE_USERNAME=auth_user
AUTH_DATASOURCE_PASSWORD=replace-with-local-auth-password
AUTH_JPA_DDL_AUTO=none

# auth-service Redis
AUTH_REDIS_HOST=localhost
AUTH_REDIS_PORT=6380
AUTH_VERIFICATION_LOG_CODE_ENABLED=true

# member-service datasource
MEMBER_DB_NAME=member_service
MEMBER_DB_ROOT_PASSWORD=replace-with-local-member-root-password
MEMBER_DB_USERNAME=member_user
MEMBER_DB_PASSWORD=replace-with-local-member-password
MEMBER_DATASOURCE_URL=jdbc:mysql://localhost:3308/member_service?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MEMBER_DATASOURCE_USERNAME=member_user
MEMBER_DATASOURCE_PASSWORD=replace-with-local-member-password
MEMBER_JPA_DDL_AUTO=none

# National Tax Service business status API (use the decoded service key from data.go.kr)
NTS_BUSINESS_API_SERVICE_KEY=replace-with-data-go-kr-decoded-service-key

# job-service datasource
JOB_DB_NAME=job_service
JOB_DB_ROOT_PASSWORD=replace-with-local-job-root-password
JOB_DB_USERNAME=job_user
JOB_DB_PASSWORD=replace-with-local-job-password
JOB_DATASOURCE_URL=jdbc:mysql://localhost:3309/job_service?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
JOB_DATASOURCE_USERNAME=job_user
JOB_DATASOURCE_PASSWORD=replace-with-local-job-password
JOB_JPA_DDL_AUTO=none

# matching-service datasource
MATCHING_DB_NAME=matching_service
MATCHING_DB_ROOT_PASSWORD=replace-with-local-matching-root-password
MATCHING_DB_USERNAME=matching_user
MATCHING_DB_PASSWORD=replace-with-local-matching-password
MATCHING_DATASOURCE_URL=jdbc:mysql://localhost:3310/matching_service?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MATCHING_DATASOURCE_USERNAME=matching_user
MATCHING_DATASOURCE_PASSWORD=replace-with-local-matching-password
MATCHING_JPA_DDL_AUTO=none

# Service-to-service URL
MEMBER_SERVICE_BASE_URL=http://localhost:8082

# Kakao OAuth2
KAKAO_OAUTH_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_OAUTH_CLIENT_SECRET=

# Naver OAuth2
NAVER_OAUTH_CLIENT_ID=replace-with-naver-client-id
NAVER_OAUTH_CLIENT_SECRET=replace-with-naver-client-secret
